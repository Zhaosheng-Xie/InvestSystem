        "bundle_hash": "5224e8e6d600b8f613d6dfaf4dd486d6caafdcf5fe3d8d3db29af2f25462a32d"
      },
      "4A-2": {
        "bundle_id": "industrial_event_stage4_4a2_event_semantics",
        "bundle_version": "0.1.0",
        "bundle_hash": "9f9f5cf843347a1918a894be1151c0ef720bd6318daa1077657e97e9324d6560"
      }
    },
    "shared_semantics": {
      "decimal_arithmetic": "fixed_point_only",
      "gate_evaluation_states": ["evaluated", "not_evaluated"],
      "gate_outcomes": ["PASS", "REJECT", "ABSTAIN", "BLOCKED", "SHADOW_ONLY"],
      "outcome_priority": ["BLOCKED", "REJECT", "ABSTAIN", "SHADOW_ONLY", "PASS"],
      "missing_is_not_false": true,
      "not_evaluated_is_not_an_outcome": true,
      "score_compensation_forbidden": true,
      "shadow_only_is_a_research_label_not_run_authority": true,
      "gate3_gate4_and_full_decision_forbidden_in_4a3": true
    },
    "rule_modules": {
      "FR-GATE-001": {
        "requirement_id": "FR-GATE-001",
        "proposal_rule_ref": "draft:gate_orchestration_and_partial_boundary:v0.1.0",
        "status": "draft",
        "semantics": {
          "fixed_order": [
            "governance_and_capability",
            "4A-1:profit_beneficiary_and_four_gate_eligible",
            "4A-2:audit_party_e4_event_state",
            "gate_1_authenticity",
            "gate_2_profit_and_cash_materiality",
            "gate_3_expectation_gap_4A-4",
            "gate_4_value_and_executable_return_4A-4",
            "full_stage4_decision"
          ],
          "short_circuit": {
            "first_non_pass_stops_later_gates": true,
            "not_evaluated_outcome": null,
            "short_circuit_reason_required": true,
            "reject_not_downgraded_by_later_not_evaluated": true
          },
          "gate_1_mapping": {
            "governance_capability_hash_pit_or_audit_structure_failure": "BLOCKED",
            "not_profit_beneficiary_or_e4_explicitly_refuted": "REJECT",
            "current_state_e3_5_without_hard_failure": "SHADOW_ONLY",
            "critical_upstream_unknown_conflicted_or_unrecoverable": "ABSTAIN",
            "pass_requires": [
              "4A-1:profit_beneficiary",
              "4A-1:four_gate_eligible",
              "4A-2:audit_PASS",
              "4A-2:party_PASS",
              "4A-2:e4_PASS",
              "4A-2:event_state_PASS_and_E4_attained",
              "4A-2:independent_gate_evidence_ready"
            ],
            "independent_evidence": {
              "minimum_public_chains": 2,
              "minimum_authoritative_original_chains": 1,
              "different_responsible_publishers": true,
              "different_acquisition_lineages": true
            }
          },
          "gate_2_entry": "gate_1_PASS_only",
          "partial_completion": {
            "gate2_pass_output": "gate2_research_qualified",
            "remaining_gate_ids": ["FR-GATE-004", "FR-GATE-005"],
            "gate_3_state": "not_evaluated:RULE_BATCH_NOT_APPROVED",
            "gate_4_state": "not_evaluated:RULE_BATCH_NOT_APPROVED",
            "full_stage4_decision": null,
            "position_state": "FLAT",
            "target_weight": null,
            "order_intent": null,
            "trade_ready_forbidden": true
          },
          "audit_fields": [
            "evaluation_state",
            "outcome",
            "reason_codes",
            "fact_ids",
            "assumption_ids",
            "derived_ids",
            "rule_id",
            "rule_version",
            "rule_hash",
            "as_of"
          ]
        }
      },
      "FR-GATE-002": {
        "requirement_id": "FR-GATE-002",
        "proposal_rule_ref": "draft:counterfactual_ntm_profit_and_gate2:v0.1.0",
        "status": "draft",
        "semantics": {
          "ntm_window": {
            "anchor": "e4_first_public_at_date",
            "duration": "half_open_[anchor_date,anchor_date_plus_12_calendar_months)",
            "knowledge_cutoff_gte_anchor": true,
            "fact_available_at_lte_e4_first_public_at": true,
            "currency_unit_and_accounting_basis_fixed_per_scenario_set": true,
            "presentation_currency_required": true,
            "foreign_currency_requires_pit_fx_fact_or_assumption_translation_date_and_version": true,
            "admissible_fx_material_missing": "ABSTAIN",
            "silent_fx_conversion_or_basis_hash_drift": "BLOCKED"
          },
          "counterfactual_denominator": {
            "definition": "event_absent_ntm_normalized_profit_attributable_to_listed_company_shareholders",
            "formula": "recurring_operating_revenue-recurring_operating_cost-recurring_selling_expense-recurring_administrative_expense-recurring_research_expense-net_finance_cost-recurring_impairment_and_credit_losses+recurring_other_operating_income+recurring_investment_and_associate_income-normalized_income_tax-minority_interest_deduction",
            "nonnegative_magnitude_components": [
              "recurring_operating_cost",
              "recurring_selling_expense",
              "recurring_administrative_expense",
              "recurring_research_expense",
              "recurring_impairment_and_credit_losses",
              "normalized_income_tax",
              "minority_interest_deduction"
            ],
            "signed_finance_cost_convention": "positive_cost_negative_income",
            "bottom_up_company_or_segment_bridge_required": true,
            "consensus_and_ttm_cross_check_only": true,
            "event_effects_must_be_removed": true,
            "nonrecurring_exclusions": [
              "asset_disposal",
              "non_operating_subsidy",
              "fair_value_change",
              "debt_restructuring",
              "one_off_tax",
              "one_off_impairment_reversal"
            ],
            "declared_calculation_graph_contains_event_or_double_counting": "BLOCKED",
            "admissible_event_removal_amount_or_component_missing_or_conflicted": "ABSTAIN"
          },
          "denominator_track": {
            "required_values": [
              "base_counterfactual_profit",
              "downside_counterfactual_profit",
              "counterfactual_profit_interval.lower",
              "counterfactual_profit_interval.upper"
            ],
            "standard_track": "base>0_AND_downside>0_AND_interval.lower>0",
            "fragile_profit_shadow_track": "complete_bridge_AND_any_of_base_downside_interval.lower_lte_0",
            "fixed_cross_company_near_zero_amount_or_margin_threshold_forbidden": true,
            "interval_propagation": "deterministic_interval_arithmetic_same_formula_no_cross_scenario_endpoint_cherry_pick",
            "fragile_materiality_ratio": null,
            "unreliable_interval": "ABSTAIN"
          },
          "event_incremental_bridge": {
            "profit_formula": "ntm_recognizable_revenue-incremental_operating_cost-incremental_operating_expense-incremental_tax_and_surcharges-incremental_financing_cost-minority_interest_deduction",
            "fcf_formula": "ntm_incremental_parent_normalized_profit+incremental_non_cash_items-incremental_working_capital-incremental_capex",
            "revenue_requires": [
              "binding_obligation",
              "delivery_and_acceptance_timing",
              "net_price",
              "revenue_recognition_basis"
            ],
            "contract_total_revenue_share_industry_asp_historical_gpm_or_llm_cannot_substitute": true
          },
          "profit_materiality": {
            "formula": "base.ntm_incremental_parent_normalized_profit/base_counterfactual_profit",
            "standard_track_only": true,
            "threshold": "0.10",
            "comparison": "gte",
            "threshold_scope": "stage4_synthetic_research_validation_only"
          },
          "gate_2_mapping": {
            "governance_hash_unit_time_double_count_or_calculation_graph_failure": "BLOCKED",
            "required_economic_bridge_interval_or_scenario_missing_or_conflicted": "ABSTAIN",
            "complete_base_materiality_lt_0_10": "REJECT",
            "only_upside_materiality_gte_0_10": "REJECT",
            "fragile_profit_shadow_track": "SHADOW_ONLY",
            "base_materiality_gte_0_10_but_base_incremental_fcf_lte_0": "SHADOW_ONLY",
            "pass_requires": [
              "standard_track",
              "base_materiality_gte_0_10",
              "base_incremental_parent_normalized_profit_gt_0",
              "base_incremental_fcf_gt_0",
              "four_scenarios_complete"
            ],
            "probability_upside_gpm_heat_or_valuation_compensation_forbidden": true
          }
        }
      },
      "FR-GATE-003": {
        "requirement_id": "FR-GATE-003",
        "proposal_rule_ref": "draft:four_scenario_consistency:v0.1.0",
        "status": "draft",
        "semantics": {
          "required_scenarios": {
            "base": "most_likely_public_evidence_path_not_mechanical_midpoint",
            "downside": "plausible_adverse_path_with_at_least_one_supported_worse_load_bearing_driver",
            "upside": "supported_positive_path_with_at_least_one_observable_trigger",
            "stress": "extreme_but_realistic_capital_loss_or_liquidity_path"
          },
          "stress_does_not_replace_downside": true,
          "driver_schema": [
            "binding_amount_or_quantity",
            "net_unit_price",
            "delivery_and_acceptance_timing",
            "ntm_revenue_recognition",
            "incremental_operating_cost_or_margin",
            "incremental_operating_expense",
            "tax_and_surcharges",
            "financing_cost",
            "minority_interest",
            "non_cash_items",
            "working_capital",
            "capex",
            "cash_collection_timing",
            "fx_rate_and_translation_basis"
          ],
          "driver_required_fields": [
            "source_fact_ids",
            "assumption_id",
            "as_of",
            "value",
            "unit",
            "uncertainty_interval",
            "trigger",
            "falsifier"
          ],
          "driver_policy": {
            "unchanged_drivers_explicitly_inherit_base": true,
            "changed_drivers_require_causal_reason": true,
            "independent_best_value_cherry_pick_forbidden": true,
            "hidden_defaults_forbidden": true
          },
          "consistency": {
            "same_formula_window_currency_unit_tax_minority_and_ownership_basis": true,
            "upside_profit_gte_base_gte_downside": true,
            "upside_base_downside_profit_ordering_failure": "BLOCKED",
            "stress_severity_metrics": [
              "incremental_profit_lower",
              "incremental_fcf_lower",
              "peak_external_financing_need_higher",
              "minimum_liquidity_headroom_lower",
              "irreversible_writeoff_higher"
            ],
            "stress_requires_at_least_one_strictly_worse_declared_metric": true,
            "other_apparently_better_stress_metric_requires_versioned_cash_timing_or_cancellation_reason": true,
            "unexplained_apparently_better_stress_metric": "ABSTAIN"
          },
          "unbound_growth_policy": {
            "repeat_purchase_expansion_share_gain_or_price_increase": "upside_only_until_new_binding_public_fact",
            "new_binding_fact_requires_new_scenario_set_version": true
          },
          "probability_policy": {
            "optional": true,
            "if_any_then_all_base_downside_upside": true,
            "mutually_exclusive": true,
            "exact_sum": "1.000000",
            "calibration_sample_method_version_and_as_of_required": true,
            "stress_probability": null,
            "weighted_value_is_display_only": true,
            "may_not_change_gate_2": true
          },
          "failure_policy": {
            "missing_scenario_driver_or_gate2_output": "ABSTAIN",
            "future_nonpublic_unknown_source_cross_run_implicit_hidden_default_or_hash_unit_dependency_failure": "BLOCKED"
          },
          "version_policy": {
            "append_only": true,
            "scenario_set_id_version_hash_and_supersedes_required": true,
            "fixed_input_rule_migration_replay_required": true,
            "replay_hash_mismatch_or_unreplayable": "BLOCKED",
            "writeback_to_kb": false,
            "authorizes_positions": false,
            "authorizes_orders": false
          }
        }
      }
