        "estimator": "mean(paired_delta_rate_over_all_frozen_candidates)",
        "cluster_key": "listed_company_id",
        "algorithm": "RADEMACHER_CLUSTER_WILD_BOOTSTRAP",
        "residual": "paired_delta_rate_i-mean_paired_delta_rate",
        "draw": "mean_paired_delta_rate+mean(cluster_multiplier_i*residual_i)",
        "ci": "two_sided_percentile_95",
        "null_p_value_draw": "mean(cluster_multiplier_i*residual_i)",
        "one_multiplier_per_cluster": true,
        "resamples": 10000,
        "seed": 20260821
      },
      "risk_cluster_sensitivity": {
