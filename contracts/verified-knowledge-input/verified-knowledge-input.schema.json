{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.investsystem.local/verified-knowledge-input/0.1.0-draft/verified-knowledge-input.schema.json",
  "title": "VerifiedKnowledgeInput (InvestSystem Draft)",
  "description": "InvestSystem-owned provider-neutral input contract. It is not an InvestmentResearchKB official schema and contains no adapter or transport DTO.",
  "x-owner": "InvestSystem",
  "x-contract-status": "draft",
  "x-contract-version": "0.1.0-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "strategy_input_ref",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "input_id": {
      "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/id"
    },
    "strategy_input_ref": {
      "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/strategyInputRef"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.investsystem.local/verified-knowledge-input/0.1.0-draft/verified-knowledge-input.schema.json#/$defs/verifiedFact"
      }
    }
  },
  "$defs": {
    "verifiedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "subject_id",
        "predicate",
        "value",
        "verified_at",
        "available_at",
        "evidence_ids",
        "event_at",
        "source_published_at",
        "first_seen_at",
        "metadata"
      ],
      "properties": {
        "fact_id": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/id"
        },
        "subject_id": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/id"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/jsonValue"
        },
        "verified_at": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/utcTimestamp"
        },
        "available_at": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/utcTimestamp"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/id"
          }
        },
        "event_at": {
          "anyOf": [
            {
              "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_published_at": {
          "anyOf": [
            {
              "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_seen_at": {
          "anyOf": [
            {
              "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/jsonValue"
          }
        }
      }
    }
  }
}
