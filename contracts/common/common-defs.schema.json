{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json",
  "title": "InvestSystem Common Contract Definitions (Draft)",
  "description": "InvestSystem-owned draft definitions. This document is not an InvestmentResearchKB official schema.",
  "x-owner": "InvestSystem",
  "x-contract-status": "draft",
  "x-contract-version": "0.1.0-draft",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "exactReleaseId": {
      "type": "string",
      "pattern": "^(?![Ll][Aa][Tt][Ee][Ss][Tt]$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "jsonValue": {
      "description": "JSON value profile that deliberately excludes all floating-point numbers.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "strategyInputRef": {
      "type": "object",
      "description": "InvestSystem's Stage 1 preservation shape for the PRD five-field reference. Provider compatibility is validated only against a separately pinned official contract in Stage 2A.",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "dataset_release_id",
        "knowledge_cutoff",
        "release_manifest_schema_version",
        "manifest_hash"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "dataset_release_id": {
          "$ref": "#/$defs/exactReleaseId"
        },
        "knowledge_cutoff": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "release_manifest_schema_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "manifest_hash": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    }
  }
}
