{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-research-kb:contract:release-data-profile:v1",
  "title": "Release Data Profile v1",
  "description": "Consumer-neutral producer validation profile for exact Release bytes and objective data domains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "created_at", "release",
    "dependency_closure_hash", "domains", "redistribution", "profile_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {
      "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"
    },
    "created_at": {
      "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/utcTimestamp"
    },
    "release": {
      "$ref": "urn:investment-research-kb:contract:release-reference:v1"
    },
    "dependency_closure_hash": {
      "oneOf": [
        {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sha256Ref"},
        {"type": "null"}
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/domainProfile"}
    },
    "redistribution": {"$ref": "#/$defs/redistribution"},
    "profile_hash": {
      "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sha256Ref"
    }
  },
  "$defs": {
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_inclusive", "end_inclusive"],
      "properties": {
        "start_inclusive": {
          "oneOf": [
            {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/date"},
            {"type": "null"}
          ]
        },
        "end_inclusive": {
          "oneOf": [
            {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/date"},
            {"type": "null"}
          ]
        }
      }
    },
    "domainProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id", "artifact_ids", "grain", "primary_keys", "date_range",
        "record_count", "required_missing_count", "duplicate_key_count",
        "orphan_reference_count", "pit_result", "revision_lineage_result",
        "population_status", "declared_missing_items", "unrecoverable_items"
      ],
      "properties": {
        "domain_id": {
          "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"
          }
        },
        "grain": {
          "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/nonEmptyText"
        },
        "primary_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"
          }
        },
        "date_range": {"$ref": "#/$defs/dateRange"},
        "record_count": {"type": "integer", "minimum": 0},
        "required_missing_count": {"type": "integer", "minimum": 0},
        "duplicate_key_count": {"type": "integer", "minimum": 0},
        "orphan_reference_count": {"type": "integer", "minimum": 0},
        "pit_result": {
          "type": "string",
          "enum": ["passed", "failed", "incomplete", "not_applicable"]
        },
        "revision_lineage_result": {
          "type": "string",
          "enum": ["passed", "failed", "incomplete", "not_applicable"]
        },
        "population_status": {
          "type": "string",
          "enum": [
            "includes_inactive_failed_and_delisted",
            "survivor_only",
            "mixed_or_partial",
            "not_applicable",
            "unknown"
          ]
        },
        "declared_missing_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/nonEmptyText"
          }
        },
        "unrecoverable_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/nonEmptyText"
          }
        }
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_hash", "limitations"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["allowed", "forbidden", "pending_explicit_permission", "unknown"]
        },
        "evidence_hash": {
          "oneOf": [
            {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sha256Ref"},
            {"type": "null"}
          ]
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/nonEmptyText"
          }
        }
      }
    }
  }
}
