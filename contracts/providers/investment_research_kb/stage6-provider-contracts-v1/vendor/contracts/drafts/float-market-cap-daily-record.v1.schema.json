{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-research-kb:record:float-market-cap-daily:v1",
  "title": "Float Market Capitalization Daily Record v1",
  "description": "PIT circulating shares and CNY float market capitalization for one security/session, with frozen mark and share-basis identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "float_market_cap_id", "security_id", "exchange",
    "session_date", "currency", "float_shares", "unadjusted_close",
    "float_market_cap_cny", "calculation_policy_version", "calendar_record_id",
    "session_state_id", "mark_id", "share_basis_hash", "mark_basis_hash",
    "economic_at", "observed_at", "available_at", "knowledge_cutoff",
    "availability_evidence", "source", "revision", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "float_market_cap_id": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"},
    "security_id": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"},
    "exchange": {"type": "string", "enum": ["SSE", "SZSE", "BSE"]},
    "session_date": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/date"},
    "currency": {"const": "CNY"},
    "float_shares": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/positiveCanonicalDecimal"},
    "unadjusted_close": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/positiveCanonicalDecimal"},
    "float_market_cap_cny": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/positiveCanonicalDecimal"},
    "calculation_policy_version": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/version"},
    "calendar_record_id": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"},
    "session_state_id": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"},
    "mark_id": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/id"},
    "share_basis_hash": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sha256Ref"},
    "mark_basis_hash": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sha256Ref"},
    "economic_at": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/economicTime"},
    "observed_at": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/utcTimestamp"},
    "available_at": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/utcTimestamp"},
    "knowledge_cutoff": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/utcTimestamp"},
    "availability_evidence": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/availabilityEvidence"},
    "source": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sourceRef"},
    "revision": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/revisionLineage"},
    "content_hash": {"$ref": "urn:investment-research-kb:defs:historical-public:v1#/$defs/sha256Ref"}
  }
}
