{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-research-kb:contract:release-status-history:v1",
  "title": "Release Status History v1",
  "description": "A complete, exact-release status chain whose last event is the current status authority evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "current_status_event",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "release_id": {
      "$ref": "#/$defs/releaseId"
    },
    "current_status_event": {
      "$ref": "urn:investment-research-kb:contract:release-status-event:v1"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:investment-research-kb:contract:release-status-event:v1"
      }
    }
  },
  "$defs": {
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "not": {
        "const": "latest"
      }
    }
  }
}
