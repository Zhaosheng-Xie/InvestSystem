{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.investsystem.local/artifact-consumption-receipt/0.1.0-draft/artifact-consumption-receipt.schema.json",
  "title": "ArtifactConsumptionReceipt (InvestSystem Draft)",
  "description": "InvestSystem-owned deterministic identity for one exact verified artifact set. Transport observations are excluded from the receipt identity.",
  "x-owner": "InvestSystem",
  "x-contract-status": "draft",
  "x-contract-version": "0.1.0-draft",
  "x-canonical-profile": "investsystem-canonical-json-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consumer_contract_version",
    "strategy_input_ref",
    "artifacts",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "consumer_contract_version": {
      "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/semanticVersion"
    },
    "strategy_input_ref": {
      "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/strategyInputRef"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactReceiptItem"
      }
    },
    "receipt_hash": {
      "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/sha256Digest"
    }
  },
  "$defs": {
    "artifactReceiptItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "item_type",
        "artifact_hash",
        "size_bytes",
        "record_count"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/providerOpaqueId"
        },
        "item_type": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/id"
        },
        "artifact_hash": {
          "$ref": "https://schemas.investsystem.local/common/0.1.0-draft/common-defs.schema.json#/$defs/sha256Digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
